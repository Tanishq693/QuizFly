{
  "manifest_version": 3,
  "name": "QuizFly - Active Recall Quiz Generator",
  "version": "1.0.0",
  "description": "Turn any article or webpage into an interactive active-recall quiz in seconds.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.quizfly.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QuizFly: Turn this page into a quiz",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
